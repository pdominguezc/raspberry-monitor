[Unit]
Description=Raspberry Pi Monitor - API de métricas del sistema
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pdominguezc
WorkingDirectory=/home/pdominguezc/raspberry-monitor/backend
Environment=PATH=/home/pdominguezc/raspberry-monitor/backend/venv/bin
ExecStart=/home/pdominguezc/raspberry-monitor/backend/venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8001
Restart=on-failure
RestartSec=5

# Endurecimiento básico
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/home/pdominguezc/raspberry-monitor/backend/data

[Install]
WantedBy=multi-user.target
