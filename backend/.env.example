# Copia este archivo a ".env" y define tus propios valores.

# Token secreto que deben enviar todos los clientes (web, HA, app) para
# acceder a la API. Genera uno fuerte, por ejemplo con:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
API_TOKEN=cambia-esto-por-un-token-largo-y-aleatorio

HOST=0.0.0.0
PORT=8000

# Cada cuántos segundos se muestrean las métricas y se guardan en el histórico.
SAMPLE_INTERVAL_SECONDS=30

# Cuántos días se conservan las muestras y el log de accesos.
HISTORY_RETENTION_DAYS=14
ACCESS_LOG_RETENTION_DAYS=30

# Ruta a la base de datos SQLite (se crea sola si no existe).
DB_PATH=./data/monitor.db

# Carpeta con el sitio estático (dashboard web / PWA).
FRONTEND_DIR=../frontend

# --- Alertas por correo cuando una métrica supera un umbral (opcional) ---
# Deja un umbral vacío para desactivar la alerta de esa métrica en particular.
# Si ALERT_EMAIL_TO está vacío, no se manda ningún correo (el monitoreo sigue
# funcionando igual, solo no avisa).
ALERT_EMAIL_TO=
ALERT_CPU_PERCENT=90
ALERT_MEMORY_PERCENT=90
ALERT_DISK_PERCENT=90
ALERT_TEMPERATURE_C=75
# Cuántos minutos esperar antes de volver a avisar de la MISMA métrica
# mientras siga por sobre el umbral (para no llenarte el correo).
ALERT_COOLDOWN_MINUTES=30

# SMTP para enviar esos correos — puedes usar las mismas credenciales que ya
# configuraste para mi-webpage (Gmail necesita una "contraseña de aplicación",
# no tu clave normal: https://myaccount.google.com/apppasswords).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
